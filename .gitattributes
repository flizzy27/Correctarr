# The image runs Linux. If Git switched to CRLF when checking out on Windows,
# the entry script would fail inside the container with "/bin/sh^M: bad
# interpreter" — an error that is hard to trace back to its cause.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf
LICENSE     text eol=lf

*.png       binary
*.jpg       binary
*.ico       binary
*.db        binary
