# Im Abbild läuft Linux. Würde Git beim Auschecken unter Windows auf CRLF
# umstellen, scheiterte das Einstiegsskript im Container mit
# „/bin/sh^M: bad interpreter“ — ein Fehler, der sich nur schwer zuordnen lässt.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf
LICENSE     text eol=lf

*.png       binary
*.jpg       binary
*.ico       binary
*.db        binary
